# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Neon PostgreSQL Connection String
# Get this from your Neon Console (https://console.neon.tech) -> Dashboard -> Connection Details
# Select "Connection string" with "psql" or "Node.js".
# - Direct connection: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# - Pooled connection (recommended for high concurrency): postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# SSL mode (leave as true or unset for Neon; Neon requires SSL)
DB_SSL=true

# Long random secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://127.0.0.1:5500

# Port the API listens on (hosting platforms usually inject this automatically)
PORT=4000

# Used to seed the very first bootstrap admin account (optional overrides)
ADMIN_NAME=Satvikk
ADMIN_EMAIL=admin@rush.local
ADMIN_PASSWORD=ChangeMe_Immediately123!
