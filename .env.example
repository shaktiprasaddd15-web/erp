# Copy to .env in the project root (same folder as docker-compose.yml).
# NEVER commit the real .env to git.

# --- Neon PostgreSQL (Cloud Managed) ---
# If using Neon, set your connection string below and DB_SSL=true:
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_SSL=true

# --- Local Docker Postgres (Self-Hosted) ---
# If running the local Postgres container via docker-compose:
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Secret used to sign login sessions. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

JWT_EXPIRES_IN=8h

# With Nginx proxying same-origin, CORS_ORIGIN mainly matters if you ever
# call the API from a different domain.
CORS_ORIGIN=http://localhost,http://127.0.0.1

# Used once by backend/scripts/seed.js to build placeholder employee emails
SEED_EMAIL_DOMAIN=yourcompany.com
